{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 6,

    "modules-left": [
        "hyprland/workspaces",
        "custom/tidal"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/mic",
        "wireplumber",
        "network",
        "power-profiles-daemon",
        "battery",
        "custom/gpu",
        "tray",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true
    },

    "custom/tidal": {
        "format": "{}",
        "return-type": "json",
        "exec": "tidal-status",
        //"exec": "playerctl -p tidal-hifi metadata --format '{{artist}} - {{title}}' 2>/dev/null || echo 'Kein Titel'",
        "interval": 1,
        "on-click": "playerctl -p tidal-hifi play-pause",
        "on-click-right": "/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=com.mastermindzh.tidal-hifi com.mastermindzh.tidal-hifi",
        "on-scroll-up": "playerctl -p tidal-hifi next",
        "on-scroll-down": "playerctl -p tidal-hifi previous",
        "max-length": 50
    },

    "custom/gpu": {
        "exec": "gpu-status",
        "interval": 60,
        "format": "{}",
        "tooltip-format": "Aktuelle GPU"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Profil: {profile}",
        "format-icons": {
            "default": "",
            "performance": "\udb86\ude88",
            "balanced": "\udb81\udda7",
            "power-saver": "\udb84\udea3"
        }
    },

    "custom/mic": {
        "exec": "~/.local/bin/mic-status",
        "return-type": "json",
        "interval": "once",
        "signal": 1,
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle && pkill -RTMIN+1 waybar",
        "on-click-right": "kitty alsamixer --view=catpture",
        "tooltip": true
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "\ueee8",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "kitty alsamixer --view=playback",
        "max-volume": 100,
        "format-icons": ["\uf026", "\uf027", "\uf028"]
    },

    "network": {
        "format-wifi": "\uf1eb {signalStrength}%",
        "format-ethernet": "\udb80\ude00",
        "format-disconnected": "\udb80\udf19",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}\nGW: {gwaddr}",
        "tooltip-format-wifi": "Interface: {ifname}\nIP: {ipaddr}\nGW: {gwaddr}\nNetwork: {essid}\nSignal: {signalStrength}%",
        "on-click": "kitty netbrowse",
        "on-click-right": "kitty nmtui"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "\ueea1 {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"]
    },

    "clock": {
        "format": "{:%d.%m.%Y %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "kitty ikhal",
        "on-click-right": "kitty neomutt"
    },

    "tray": {
        "spacing": 8
    },

    "custom/power": {
        "format": "\u23fb",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power_menu.xml",
        "menu-actions": {
            "shutdown": "shutdown -h now",
            "reboot": "reboot",
            "suspend": "systemctl suspend"
            //"hibernate": "systemctl hibernate"
        }
    }
}
